1.  display the count of unlicensed movies in the database

select count(*) from movie m left join movielicense ml
on m.movieid = ml.movieid where ml.movieid is Null;


2. display the name , species , gender , first name and last name of caretaker  as full name for all the male animals .

select a.name , a.species , a.gender , 
  concat(ct.first_name,' ', ct.last_name) as caretaker_name
  from animal a 
join animal_caretaker ac on a.animal_id = ac.animal_id
join caretaker ct on ct.caretaker_id = ac.caretaker_id
where a.gender = "Male";


3. display fname , lastname , posiition , total sales they made and return them in descending order

select concat(s.firstname, " ", s.lastname) as name ,
s.position , sum(o.totalamount) as total_sales
from staff s join orders o on s.staffid = o.staffid 
  where o.status = "Completed"
group by o.staffid order by total_sales desc; 


4. Write an SQL query to display:
Title, description, and genre of TV shows that belong to the 'Kids' genre.


select title , description , genre from tvshow where genre ="Kids";


5. Write an SQL query to display:
Order ID, User ID, and Total Price of orders whose total price is greater than 15.


